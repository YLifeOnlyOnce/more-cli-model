{
  "name": "ts-cli-learning-example",
  "version": "1.0.0",
  "description": "A TypeScript CLI learning example with guided docs.",
  "type": "commonjs",
  "bin": {
    "learn-cli": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --enable-source-maps dist/index.js",
    "start": "node dist/index.js",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "cli",
    "typescript",
    "nodejs",
    "learning"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.14",
    "typescript": "^5.8.2"
  }
}
